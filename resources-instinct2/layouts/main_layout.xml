<layouts>
    <layout id="MainLayout">
        <!-- Top-Left Area: Elapsed Time Header & Value -->
        <label id="ElapsedTimeHeader" x="10" y="16" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_LEFT" color="Graphics.COLOR_WHITE" text="ELAPSED" />
        <label id="ElapsedTime" x="10" y="34" font="Graphics.FONT_TINY" justification="Graphics.TEXT_JUSTIFY_LEFT" color="Graphics.COLOR_WHITE" text="00:00" />
        <!-- Sub-Window Circle Lens (Top-Right on Instinct 2: x=142, y=34) -->
        <label id="WaveCount" x="142" y="34" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="0" />
        <!-- Bottom Split Area: Labels above Surf Time and TOD -->
        <label id="SurfTimeHeader" x="44" y="120" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="SURF TIME" />
        <label id="SurfTime" x="44" y="138" font="Graphics.FONT_TINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="00:00" />
        <label id="ClockTimeHeader" x="132" y="120" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="TOD" />
        <label id="ClockTime" x="132" y="138" font="Graphics.FONT_TINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="12:00" />
    </layout>
</layouts>
