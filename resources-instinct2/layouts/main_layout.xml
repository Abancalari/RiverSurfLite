<layouts>
    <layout id="MainLayout">
        <!-- Top-Left Area: Elapsed Time Header & Value (Shifted right to x=18 to prevent clipping) -->
        <label id="ElapsedTimeHeader" x="18" y="16" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_LEFT" color="Graphics.COLOR_WHITE" text="ELAPSED" />
        <label id="ElapsedTime" x="18" y="34" font="Graphics.FONT_TINY" justification="Graphics.TEXT_JUSTIFY_LEFT" color="Graphics.COLOR_WHITE" text="00:00" />
        <!-- Sub-Window Circle Lens (Centered Number Font Medium on Instinct 2: x=142, y=14) -->
        <label id="WaveCount" x="142" y="14" font="Graphics.FONT_NUMBER_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="0" />
        <!-- Bottom Split Area: Labels above Surf Time and Clock Time -->
        <label id="SurfTimeHeader" x="44" y="120" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="SURF TIME" />
        <label id="SurfTime" x="44" y="138" font="Graphics.FONT_TINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="00:00" />
        <label id="ClockTimeHeader" x="132" y="120" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="TIME" />
        <label id="ClockTime" x="132" y="138" font="Graphics.FONT_TINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="12:00" />
    </layout>
</layouts>
