        <label id="WaveCount" x="50%" y="22%" font="Graphics.FONT_SMALL" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="0" />
        <!-- Bottom Split Area: Labels above Surf Time and TOD -->
        <label id="SurfTimeHeader" x="25%" y="67%" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="SURF TIME" />
