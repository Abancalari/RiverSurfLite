        <string id="MetersUnit">m</string>
        <string id="StateUnit">state</string>
        <string id="Mg2Unit">mg²</string>
    </strings>

    <!-- 2. Launcher Icon Bitmap Element -->
    <drawables>
        <bitmap id="LauncherIcon" filename="icon.png" />
    </drawables>

