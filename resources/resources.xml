                  displayInActivitySummary="true" />
        <fitField id="8" 
                  dataLabel="@Strings.AccelVar" 
                  unitLabel="@Strings.Mg2Unit" 
                  sortOrder="8" 
                  precision="0" 
                  displayInChart="false" 
                  displayInActivitySummary="true" />
    </fitContributions>
</resources>
