<resources>
    <!-- 1. String Definitions -->
    <strings>
        <string id="AppName">RiverSurfLite</string>
        <string id="WaveCount">Wave Count</string>
        <string id="SurfTime">Surf Time</string>
        <string id="MaxSurfSpeed">Max Surf Speed</string>
        <string id="LongestWave">Longest Wave</string>
        <string id="WaveDuration">Wave Duration</string>
        <string id="WavesUnit">waves</string>
        <string id="SecUnit">s</string>
        <string id="MsUnit">m/s</string>
    </strings>

    <!-- 2. Launcher Icon Bitmap Element -->
    <drawables>
        <bitmap id="LauncherIcon" filename="icon.png" />
    </drawables>

    <!-- 3. Fit Field XML Schema Mapping -->
    <fitContributions>
        <fitField id="0" 
                  dataLabel="@Strings.WaveCount" 
                  unitLabel="@Strings.WavesUnit" 
                  sortOrder="0" 
                  precision="0" 
                  displayInChart="false" 
                  displayInActivitySummary="true" />
        <fitField id="1" 
                  dataLabel="@Strings.SurfTime" 
                  unitLabel="@Strings.SecUnit" 
                  sortOrder="1" 
                  precision="0" 
                  displayInChart="false" 
                  displayInActivitySummary="true" />
        <fitField id="2" 
                  dataLabel="@Strings.MaxSurfSpeed" 
                  unitLabel="@Strings.MsUnit" 
                  sortOrder="2" 
                  precision="1" 
                  displayInChart="false" 
                  displayInActivitySummary="true" />
        <fitField id="3" 
                  dataLabel="@Strings.LongestWave" 
                  unitLabel="@Strings.SecUnit" 
                  sortOrder="3" 
                  precision="0" 
                  displayInChart="false" 
                  displayInActivitySummary="true" />
        <fitField id="4" 
                  dataLabel="@Strings.WaveDuration" 
                  unitLabel="@Strings.SecUnit" 
                  sortOrder="4" 
                  precision="0" 
                  chartTitle="@Strings.WaveDuration" 
                  fillColor="#FFFF00"
                  displayInChart="true" 
                  displayInActivitySummary="false" />
    </fitContributions>
</resources>
