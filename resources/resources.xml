                  unitLabel="@Strings.WavesUnit" 
                  sortOrder="0" 
                  precision="0" 
                  displayInChart="false" 
                  displayInActivitySummary="true" />
        <fitField id="1" 
                  dataLabel="@Strings.SurfTime" 
                  unitLabel="@Strings.SecUnit" 
                  sortOrder="1" 
                  precision="0" 
                  displayInChart="false" 
                  displayInActivitySummary="true" />
        <fitField id="2" 
                  dataLabel="@Strings.MaxSurfSpeed" 
                  unitLabel="@Strings.MsUnit" 
                  sortOrder="2" 
                  precision="1" 
                  displayInChart="false" 
                  displayInActivitySummary="true" />
        <fitField id="3" 
                  dataLabel="@Strings.LongestWave" 
                  unitLabel="@Strings.SecUnit" 
                  sortOrder="3" 
                  precision="0" 
                  displayInChart="false" 
                  displayInActivitySummary="true" />
        <fitField id="4" 
                  dataLabel="@Strings.SurfState" 
                  unitLabel="@Strings.StateUnit" 
                  sortOrder="4" 
                  precision="0" 
                  chartTitle="@Strings.SurfState" 
                  fillColor="#00FFFF"
                  displayInChart="true" 
                  displayInActivitySummary="false" />
